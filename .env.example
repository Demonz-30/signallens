# Sectors API Authentication
# Obtain your API key from the Sectors dashboard: https://sectors.app
# REST API requires the raw API key without 'Bearer' prefix.
SECTORS_API_KEY=

# Execution Mode: "mock" (default for offline dev & demo reliability) or "live"
SECTORS_MODE=mock

# Optional: LLM Configuration for targeted hypothesis generation
# If not configured, SignalLens falls back deterministically to rule-based hypothesis generation.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
